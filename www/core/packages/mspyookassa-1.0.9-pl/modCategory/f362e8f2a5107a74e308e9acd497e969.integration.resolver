/** @var xPDOTransport $transport */
/** @var array $options */
/** @var modX $modx */
if ($transport->xpdo) {
    $modx =& $transport->xpdo;

    /** @var miniShop2 $miniShop2 */
    if (!$miniShop2 = $modx->getService('miniShop2')) {
        $message = '[mspYooKassa] Could not load miniShop2 class!';
    } else {
        switch ($options[xPDOTransport::PACKAGE_ACTION]) {
            case xPDOTransport::ACTION_INSTALL:
            case xPDOTransport::ACTION_UPGRADE:
                foreach ($classes as $class => $path) {
                    $miniShop2->addService('payment', $class, $path);
                }
                foreach ($payments as $row) {
                    /** @var xPDOObject|msPayment $payment */
                    if (!$payment = $modx->getObject('msPayment', ['class' => $row['class'], 'name' => $row['name']])) {
                        $payment = $modx->newObject('msPayment');
                        $payment->fromArray(array_merge([
                            'properties' => json_encode($row['properties'], JSON_UNESCAPED_UNICODE),
                            'active' => 0,
                            'rank' => $modx->getCount('msPayment') - 1,
                        ], $row)
                        );
                        $payment->save();
                    }
                }
                break;
            case xPDOTransport::ACTION_UNINSTALL:
                foreach ($classes as $class => $path) {
                    $miniShop2->removeService('payment', $class);
                    $modx->removeCollection('msPayment', ['class' => $class]);
                }
                break;
            default:
                $message = '';
                break;
        }
    }

    if (!empty($message)) {
        $modx->log(modX::LOG_LEVEL_INFO, $message);
    }
}


return true;