        'class' => 'modChunk',
        'object' => '{"id":0,"source":1,"property_preprocess":0,"name":"FileAttachTpl","description":"","editor_type":0,"category":0,"cache_type":0,"snippet":"<p>[[+description:notempty=`<strong>[[+description]]<\\/strong><br\\/>`]]\\n<a href=\\"[[+url]]\\">[[+name]]<\\/a> <span class=\\"badge\\">[[+download]]<\\/span>\\n[[+size:notempty=`<br\\/><small>Size: [[+size]] bytes<\\/small>`]]\\n[[+ext:notempty=`<br\\/><small>Type: <img src=\\"\\/img\\/[[+ext]].png\\" \\/><\\/small>`]]\\n[[+hash:notempty=`<br\\/><small>SHA1: [[+hash]]<\\/small>`]]<\\/p>","locked":0,"properties":null,"static":1,"static_file":"core\\/components\\/fileattach\\/elements\\/chunks\\/chunk.item.tpl","content":"<p>[[+description:notempty=`<strong>[[+description]]<\\/strong><br\\/>`]]\\n<a href=\\"[[+url]]\\">[[+name]]<\\/a> <span class=\\"badge\\">[[+download]]<\\/span>\\n[[+size:notempty=`<br\\/><small>Size: [[+size]] bytes<\\/small>`]]\\n[[+ext:notempty=`<br\\/><small>Type: <img src=\\"\\/img\\/[[+ext]].png\\" \\/><\\/small>`]]\\n[[+hash:notempty=`<br\\/><small>SHA1: [[+hash]]<\\/small>`]]<\\/p>"}',
