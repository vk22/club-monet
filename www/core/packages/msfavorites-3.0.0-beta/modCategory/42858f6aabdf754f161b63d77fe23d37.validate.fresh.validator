<?php

/** @var $modx modX */
if (!$modx = $object->xpdo AND !$object->xpdo instanceof modX) {
    return true;
}


/** @var $options */
switch ($options[xPDOTransport::PACKAGE_ACTION]) {
    case xPDOTransport::ACTION_INSTALL:
    case xPDOTransport::ACTION_UPGRADE:

        if ($msFavorites = $modx->getService('msfavorites.msFavorites', '', MODX_CORE_PATH . 'components/msfavorites/model/')) {
            if (!property_exists($msFavorites, 'version') OR version_compare($msFavorites->version, '3.0.0-beta', '<')) {
                $modx->log(modX::LOG_LEVEL_ERROR, '[msFavorites] You need to delete old "msFavorites"');

                return false;
            }
        }

        break;

    case xPDOTransport::ACTION_UNINSTALL:
        break;
}

return true;